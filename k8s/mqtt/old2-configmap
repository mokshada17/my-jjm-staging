apiVersion: v1
kind: ConfigMap
metadata:
  name: mosquitto-config
  namespace: mqtt
data:
  mosquitto.conf: |
    per_listener_settings true

    persistence true
    persistence_location /mosquitto/data/
    log_dest stdout
    log_type error
    log_type warning
    log_type notice
    log_type information

    # Plain MQTT: NLB 1883 -> NodePort 31883
    listener 1883 0.0.0.0
    allow_anonymous false
    password_file /mosquitto/passwords/passwd_1883

    # Plain MQTT without TLS: NLB 8883 -> NodePort 31884
    listener 8883 0.0.0.0
    allow_anonymous false
    password_file /mosquitto/passwords/passwd_8883
