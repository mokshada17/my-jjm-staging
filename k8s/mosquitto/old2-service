apiVersion: v1
kind: Service
metadata:
  name: mosquitto
  namespace: jjm
spec:
  type: NodePort
  selector:
    app: mosquitto
  ports:
    # Internal-only non-TLS MQTT.
    # No nodePort means this is not exposed outside the cluster.
    - name: mqtt
      port: 1883
      targetPort: 1883
      protocol: TCP

    # External TLS MQTT endpoint.
    - name: mqtt-tls
      port: 8883
      targetPort: 8883
      nodePort: 30883
      protocol: TCP
